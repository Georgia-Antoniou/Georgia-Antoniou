@page "/portfolio/{project}/details"
@using MyPortfolio.Models
@inject IConfiguration root

<section class="project-details">
    <NavLink href="/portfolio" class="back-link">← Back to All Projects</NavLink>
    @if (details == null)
    {
        <p role="alert">Sorry, there's nothing at this address.</p>
    }
    else
    {
        <h2>@details.Title</h2>
        <p class="project-role">@details.Role</p>

        <p>
            @details.Description
        </p>

        <h3>My Responsibilities:</h3>
        <ul>
            <li>Identified and documented a wide range of defects, from critical crashes to minor usability issues, using screen captures and detailed steps to reproduce.</li>
            <li>Assessed the user flow and intuitiveness of the AI platform from an end-user perspective, providing actionable feedback to the development and design teams.</li>
            <li>Contributed to the overall quality and stability of the product by proactively testing new features and their interactions with existing functionalities.</li>
            <li>Provided qualitative feedback on the platform's performance, stability, and reliability under various real-world usage scenarios.</li>
        </ul>

        <h3>Key Artifacts:</h3>
        <div class="project-links">
            <a href="assets/pdfs/socra/test-cases.xlsx" class="cta-button" target="_blank">View Test Cases</a>
            <a href="assets/pdfs/ecommerce-bug-report.pdf" class="cta-button" target="_blank">View Bug Report</a>
        </div>
    }
</section>

@code {
    [Parameter]
    public string? Project { get; set; }
    private ProjectName projectName;
    private ProjectDetails details;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        projectName = ProjectName.FromEncoded(Project);
        Console.WriteLine(projectName.Name);
        details = root.GetSection($"Projects:{projectName.Name}")
            .Get<ProjectDetails>();

    }

}
