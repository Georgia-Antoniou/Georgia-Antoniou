@page "/about"
@inject IJSRuntime JSRuntime

<PageTitle>About</PageTitle>

<section id="about-me">
    <h2><i class="fas fa-user"></i>  About me</h2>
    <div class="about-container">
        <p>
            I am an enthusiastic and detail-oriented professional with a passion for quality assurance, holding the ISTQB Foundation Level certification. With a strong foundation in both manual and black-box testing methodologies, I am actively seeking a junior software tester or internship position to apply my skills in a dynamic team environment.
        </p>
    </div>

    <section id="technical-skills">
        <h2><i class="fas fa-tools"></i> Technical Skills</h2>
        <div class="skills-container">

            <div class="skill-category">
                <h3><i class="fas fa-cogs"></i> Core Testing & Methodologies</h3>
                <ul>
                    <li>**Testing Methodologies:** Manual Testing, Black-Box Testing, Exploratory Testing.</li>
                    <li>**Validation Scope:** Functional, System, Integration, and UAT coordination.</li>
                    <li>**Quality Assurance (QA):** Effective Regression Testing execution.</li>
                    <li>**Non-Functional Assurance:** Familiarity with validating performance and usability.</li>
                </ul>
            </div>

            <div class="skill-category">
                <h3><i class="fas fa-code"></i> Test Automation & Programming</h3>
                <ul>
                    <li>**Programming Language:** C# </li>
                    <li>**Automation Tools:** Playwright (Developing and maintaining UI/API automated scripts).</li>
                    <li>**IDEs:** Familiarity with Visual Studio and JetBrains Rider.</li>
                    <li>**Version Control:** Basic knowledge of Git/GitHub for code management, branching, committing, and pulling changes.</li>
                </ul>
            </div>

            <div class="skill-category">
                <h3><i class="fas fa-tasks"></i> Test Management & ALM</h3>
                <ul>
                    <li>**Project & Issue Tracking:** Jira (Expertise in defect reporting and workflow management).</li>
                    <li>**Test Case Management:** Zephyr Scale (Skilled in creating, executing, and reporting).</li>
                    <li>**DevOps Tools:** Familiarity with Azure DevOps.</li>
                </ul>
            </div>

            <div class="skill-category">
                <h3><i class="fas fa-database"></i> API, Performance, & Data</h3>
                <ul>
                    <li>**API Functional Testing:** Postman </li>
                    <li>**Performance Testing:** JMeter (Basic knowledge of running load test scenarios).</li>
                    <li>**Database:** PostgreSQL/SQL (Capable of writing base queries for backend data validation).</li>
                </ul>
            </div>

        </div>
    </section>

    <section id="certifications">
        <h2><i class="fas fa-award"></i> Certifications & Training</h2>
        <div class="cert-container">

            <div class="cert-card">
                <h3>ISTQB Foundation Level</h3>
                <p class="issuer">International Software Testing Qualifications Board (ISTQB)</p>
                <p>Formal qualification covering fundamental software testing principles and methodologies.</p>
                <a href=/assets/pdfs/Certs/ISTQB-Cert.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>Learn SQL Course</h3>
                <p class="issuer">CodeAcademy</p>
                <p>Shows ability to use SQL to inspect and validate data in relational databases, including writing queries with filters, joins, and aggregates to support testing activities.</p>
                <a href=/assets/pdfs/Certs/SQL-cert.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>Introduction to C#</h3>
                <p class="issuer">CodeAcademy</p>
                <p>Demonstrates foundational knowledge in C#, essential for automation frameworks like Playwright.</p>
                <a href=/assets/pdfs/Certs/intro_to_c_sharp.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>Intro to AI Agents Course</h3>
                <p class="issuer">CodeAcademy</p>
                <p>Builds a foundational understanding of modern AI agents, including agentic workflows, tool use, and responsible application of autonomous AI systems.</p>
                <a href=/assets/pdfs/Certs/intro_AI_agents.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>Learn C# Course</h3>
                <p class="issuer">CodeAcademy</p>
                <p>
                    Validates hands-on experience writing C# programs with variables, control flow, arrays, and lists for real-world development tasks.
                </p>
                <a href=/assets/pdfs/Certs/c_sharp_cert.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>Software Testing Bootcamp</h3>
                <p class="issuer">Udemy</p>
                <p>The theoretical foundation of the ISTQB is strongly reinforced by comprehensive knowledge gained from The Complete Software Testing Bootcamp (Udemy). This training covered Agile/Jira, API testing (Postman), Performance testing (JMeter), and initial automation concepts (Playwright/Selenium), providing a full-stack view of the modern QA workflow.</p>
                <a href=/assets/pdfs/Certs/UDEMY-CERTIFICATE-QA.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>Postman - API Testing</h3>
                <p class="issuer">Udemy</p>
                <p>Demonstrates foundational knowledge in Postman</p>
                <a href=/assets/pdfs/Certs/Postman-API-testing.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>SQL Bootcamp</h3>
                <p class="issuer">Udemy</p>
                <p>Deep dive into SQL for data analysis, focusing on advanced queries, database design principles, and data integrity. The training included practical application to solve real-world data problems, directly supporting backend validation and test setup/cleanup in QA.</p>
                <a href=/assets/pdfs/Certs/SQL-CERT.jpg target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>Learning HTML</h3>
                <p class="issuer">CodeAcademy</p>
                <p>Demonstrates foundational knowledge in HTML.</p>
                <a href=/assets/pdfs/Certs/HTML-certification.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

            <div class="cert-card">
                <h3>Learning CSS </h3>
                <p class="issuer">CodeAcademy</p>
                <p>Demonstrates foundational knowledge in CSS.</p>
                <a href=/assets/pdfs/Certs/CSS-certification.pdf target="_blank" class="cert-button">
                    Verify Credential <i class="fas fa-external-link-alt"></i>
                </a>
            </div>

        </div>
    </section>

</section>

<a class="back-to-top-button small-cta-button" aria-label="Back to Top"
   @onclick="ScrollToTop"
   @onclick:preventDefault
   @onclick:stopPropagation>
    ↑ Back to Top
</a>


@code {
    private async Task ScrollToTop()
    {
        // This JavaScript call executes window.scrollTo(0, 0);
        // which forces the browser to scroll to the top left corner (0, 0).
        await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }
}
