        ["assets/pdfs/Articles/The_Software_Testing_Life_Cycle_(STLC).pdf"] = "Software Testing Life Cycle",
        ["assets/pdfs/Articles/Entry_Criteria_VS__Exit_Criteria.pdf"] = "Entry criteria VS Exit criteria",
        ["assets/pdfs/Articles/Estimation_Techniques.pdf"] = "Estimation Techniques",
        ["assets/pdfs/Articles/The_Test_Pyramid.pdf"] = "The Test Pyramid",
