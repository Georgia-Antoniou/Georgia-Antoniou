@page "/blog"
@using System.Collections.Frozen
@inject IJSRuntime JSRuntime

<PageTitle>Blog</PageTitle>

<section id="blog">
    <h2><i class="fas fa-book"></i>  Learning by Explaining: My QA Journal</h2>
    <div class="about-container">
        <p>
            I believe the best way to master a subject is to explain it simply. This blog is my digital notebook where I apply the Feynman Technique to Software Testing. By stripping away the jargon and focusing on real-world analogies, I am solidifying my own understanding while creating a resource for others
        </p>
    </div>
    <div class="about-container">
        @foreach (var item in Articles)
        {
            <NavLink Target="_blank" Href="@item.Key" class="blog-button">@item.Value</NavLink>
        }
    </div>
</section>
<a class="back-to-top-button small-cta-button" aria-label="Back to Top"
   @onclick="ScrollToTop"
   @onclick:preventDefault
   @onclick:stopPropagation>
    ↑ Back to Top
</a>


@code {
    private static FrozenDictionary<string, string> Articles = new Dictionary<string, string>
    {
        ["assets/pdfs/Articles/Regression_Testing_vs._retesting.pdf"] = "Regression VS Retesting",
        ["assets/pdfs/Articles/Boundary_Value_Analysis__Equivalence_Partitioning.pdf"] = "Boundary value analysis VS Equivalence Partitioning",
        ["assets/pdfs/Articles/Severity_VS_Priority.pdf"] = "Severity VS Priority",
        ["assets/pdfs/Articles/Smoke_Test__VS__Sanity_Test.pdf"] = "Smoke test VS Sanity Test",
        ["assets/pdfs/Articles/Test_Case_vs._test_scenario.pdf"] = "Test case VS Test scenario",
        ["assets/pdfs/Articles/The_Bug_Life_Cycle.pdf"] = "Bug life cycle",
        ["assets/pdfs/Articles/The_Perfect_Bug_Report.pdf"] = "Bug report",
        ["assets/pdfs/Articles/ATDD.pdf"] = "ATDD",
        ["assets/pdfs/Articles/Acceptance_Criteria.pdf"] = "Acceptance Criteria",
        ["assets/pdfs/Articles/Ad-Hoc_vs.__monkey_testing.pdf"] = "Ad Hoc vs. Monkey testing",
        ["assets/pdfs/Articles/Black_Box_VS_White_Box_VS_Gray_Box.pdf"] = "Black Box VS White Box VS Gray Box",
        ["assets/pdfs/Articles/Decision_Table_Testing.pdf"] = "Decision Table Testing",
        ["assets/pdfs/Articles/Error_Guessing_VS_Checklist-Based_Testing.pdf"] = "Error Guessing VS Checklist Based Testing",
        ["assets/pdfs/Articles/Exploratory_Testing.pdf"] = "Exploratory Testing",
        ["assets/pdfs/Articles/State_Transition_Testing.pdf"] = "State Transition Testing",
        ["assets/pdfs/Articles/Static_vs.__dynamic_testing.pdf"] = "Static VS Dynamic Testing",
        ["assets/pdfs/Articles/Test_Plan_VS_Test_Strategy.pdf"] = "Test Plan VS Test Strategy",
